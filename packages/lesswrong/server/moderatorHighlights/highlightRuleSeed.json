{
  "messageTemplates": {
    "No Org Usernames": {
      "enabled": true,
      "groups": [
        [
          {
            "signal": "userDisplayName",
            "operator": "matchesRegex",
            "value": "\\b(team|labs?|institute|foundation|research|official|inc|llc|ltd|ventures?|solutions|technologies|capital|group|systems|collective)\\b",
            "explanation": "The display name contains a whole-word organization term such as team, lab, institute, research, or foundation."
          }
        ]
      ]
    },
    "Make Username Pronounceable": {
      "enabled": true,
      "groups": [
        [
          {
            "signal": "userDisplayName",
            "operator": "matchesRegex",
            "value": "\\d.*\\d.*\\d",
            "explanation": "The display name contains at least three digits, with any characters between them."
          }
        ],
        [
          {
            "signal": "userDisplayName",
            "operator": "matchesRegex",
            "value": "[bcdfghjklmnpqrstvwxz]{5,}",
            "explanation": "The display name contains a run of at least five consonants."
          }
        ],
        [
          {
            "signal": "userDisplayName",
            "operator": "matchesRegex",
            "value": "^[^ ]{24,}$",
            "explanation": "The display name is at least 24 characters long and contains no spaces."
          }
        ]
      ]
    },
    "Politics": {
      "enabled": true,
      "groups": [
        [
          {
            "signal": "contentTitlesAndTexts",
            "operator": "hasAtLeastDistinctRegexMatches",
            "value": "\\b(trump|biden|obama|kamala|democrats?|republicans?|left-wing|right-wing|elections?|presidential|congress|senate|immigration|abortion|transgender|woke|israel|gaza|palestine|palestinians?|culture war)\\b",
            "minimumMatches": 2,
            "explanation": "A single content item contains different whole-word political terms from the listed names, parties, institutions, and topics; repeated uses of one term count once."
          }
        ]
      ]
    },
    "Formatting / Grammar": {
      "enabled": true,
      "groups": [
        [
          {
            "signal": "contentPlaintexts",
            "operator": "matchesRegexCaseSensitive",
            "value": "^(?=(?:[\\s\\S]*?[.!?]\\s+[A-Za-z]){4})(?:[\\s\\S]*?[.!?]\\s+[a-z]){2}",
            "explanation": "A content item has at least four apparent sentence boundaries, including at least two followed by a lowercase letter."
          }
        ],
        [
          {
            "signal": "contentPlaintexts",
            "operator": "matchesRegexCaseSensitive",
            "value": "(?:[a-z]\\.[A-Z][a-z][\\s\\S]*?){2}",
            "explanation": "A content item has at least two periods where the next capitalized word starts immediately, without a space."
          }
        ],
        [
          {
            "signal": "contentFormattingParagraphs",
            "operator": "matchesRegexCaseSensitive",
            "value": "^[\\s\\S]{1501,}$",
            "explanation": "A paragraph contains at least 1,501 plain-text characters."
          }
        ]
      ]
    },
    "Lotsa DMs": {
      "enabled": true,
      "groups": [
        [
          {
            "signal": "activeDmFlagCount",
            "operator": "gte",
            "value": 1
          }
        ]
      ]
    },
    "This isn't gonna work out": {
      "enabled": true,
      "groups": [
        [
          {
            "signal": "sentModeratorMessageCount",
            "operator": "gte",
            "value": 2
          }
        ]
      ]
    },
    "Multiple LLM rejections": {
      "enabled": true,
      "groups": [
        [
          {
            "signal": "highPangramScoreContentCount",
            "operator": "gte",
            "value": 2
          },
          {
            "signal": "sentModeratorMessageCount",
            "operator": "gte",
            "value": 2
          }
        ]
      ]
    },
    "Barely approved AI content": {
      "enabled": true,
      "groups": [
        [
          {
            "signal": "contentTitlesAndTexts",
            "operator": "matchesRegex",
            "value": "\\b(AI|AGI|ASI|LLMs?|GPT|ChatGPT|language models?|machine learning|deep learning|neural networks?|transformers?|mechanistic interpretability|model interpretability)\\b",
            "explanation": "The selected content mentions AI, a language model, or a technical AI topic such as machine learning, neural networks, transformers, or mechanistic interpretability."
          }
        ]
      ]
    },
    "No Unmotivated Vibecoded AI Research": {
      "enabled": true,
      "groups": [
        [
          {
            "signal": "postTitlesAndTexts",
            "operator": "matchesRegexInAtLeastItems",
            "value": "(?=[\\s\\S]*\\b(AI|AGI|ASI|LLMs?|GPT|ChatGPT|language models?|machine learning|deep learning|neural networks?|transformers?|mechanistic interpretability|model interpretability)\\b)(?=[\\s\\S]*\\b(research|projects?|experiments?|experimental|methodology|architectures?|train(?:ed|ing)?|fine[- ]tun(?:e|ed|ing)|evaluat(?:e|ed|ion)|results?|benchmarks?|datasets?)\\b)",
            "minimumMatches": 2,
            "explanation": "At least 2 posts each mention AI or a technical AI topic and present an AI research project, experiment, training process, evaluation, results, benchmark, or dataset."
          },
          {
            "signal": "rejectedPostTitlesAndTexts",
            "operator": "matchesRegex",
            "value": "(?=[\\s\\S]*\\b(AI|AGI|ASI|LLMs?|GPT|ChatGPT|language models?|machine learning|deep learning|neural networks?|transformers?|mechanistic interpretability|model interpretability)\\b)(?=[\\s\\S]*\\b(research|projects?|experiments?|experimental|methodology|architectures?|train(?:ed|ing)?|fine[- ]tun(?:e|ed|ing)|evaluat(?:e|ed|ion)|results?|benchmarks?|datasets?)\\b)",
            "explanation": "At least one of the user's rejected posts mentions AI or a technical AI topic and presents an AI research project, experiment, training process, evaluation, results, benchmark, or dataset."
          }
        ]
      ]
    },
    "Semi-automoderated quality warning (downvoted)": {
      "enabled": true,
      "groups": [
        [
          {
            "signal": "hasActiveDownvotedContentAlert",
            "operator": "isTrue",
